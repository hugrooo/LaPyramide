{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["searchName", "xp", "squadId"],
      "$uid": {
        ".write": "$uid === auth.uid || auth != null" 
      }
    },
    "squads": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["xp"]
    },
    "leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["totalSips"]
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "promo_codes": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
