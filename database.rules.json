{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["searchName", "xp", "squadId"],
      "$uid": {
        ".write": "$uid === auth.uid || auth != null" 
      }
    },
    "squads": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["xp"]
    },
    "leaderboard": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["totalSips"]
    },
    "games": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "promo_codes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "friends": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "friend_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "sent_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "crews": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "community_decks": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["downloads", "creatorId"]
    },
    "deck_ratings": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
